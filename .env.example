# Copy this file to .env and fill in your values.

# ── Email ────────────────────────────────────────────────────────────────────

# Email address to receive the weekly digest
RECIPIENT_EMAIL=you@example.com

# Gmail address used to send the digest
GMAIL_SENDER=you@gmail.com

# Gmail App Password (not your normal password).
# Create one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: directory where fallback .txt / .ics files are saved (default: current dir)
OUTPUT_DIR=.


# ── Calendar invites ─────────────────────────────────────────────────────────

# Comma-separated substrings (case-insensitive) to EXCLUDE from calendar invites.
# Classes whose names contain any of these strings are skipped.
# Example: "Reformer Pilates,Barre,Meditation"
EXCLUDED_CLASSES=Reformer Pilates

# Comma-separated substrings to INCLUDE (whitelist). If set, only classes
# matching one of these get invites. Leave empty to invite all non-excluded classes.
# Example: "BODYPUMP,Spin,Yoga"
CALENDAR_CLASSES=

# Minutes before each class to fire a reminder notification (default: 30)
CALENDAR_REMINDER_MINUTES=30


# ── Google Calendar push (optional) ──────────────────────────────────────────
# If both values below are set, events are created directly in your Google Calendar.
# If not set, a fitness_classes_YYYY-MM-DD.ics file is generated instead
# (and attached to the digest email), which you can import manually.

# The calendar ID to push events into.
# Find it in Google Calendar → Settings → [calendar name] → Calendar ID
# Looks like: abc123@group.calendar.google.com  (or just "primary")
GOOGLE_CALENDAR_ID=

# Absolute path to a Google service-account key JSON file.
# The service account must be granted "Make changes to events" access on the calendar.
# Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON=
